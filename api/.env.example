PORT=3001

# Necessária para a IA responder. Sem essa chave, a API responde com erro 503
# e uma mensagem fixa direcionando pro WhatsApp.
ANTHROPIC_API_KEY=

# Modelo usado pela IA. claude-haiku-4-5 é o mais barato (padrão).
# Outras opções: claude-sonnet-5, claude-opus-5.
AI_MODEL=claude-haiku-4-5

# Dados do negócio usados pelo robô nas respostas.
BUSINESS_ADDRESS=
BUSINESS_HOURS=
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=19:00
# Dias abertos: 0=domingo, 1=segunda, ..., 6=sábado. Precisa bater com o texto de BUSINESS_HOURS acima.
BUSINESS_OPEN_DAYS=1,2,3,4,5,6

# Preço de cada serviço (aparecem nas respostas de "preços e serviços").
PRICE_FACIAL=
PRICE_CILIOS=
PRICE_CORPORAL=
PRICE_LASH_LIFTING=
PRICE_BROW=

# Integração com o Google Agenda (agendamento automático).
# Deixe em branco enquanto não configurar — sem essas 3 variáveis, o robô avisa
# a cliente que o agendamento automático ainda não está ativo, em vez de dar erro.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_TIMEZONE=America/Sao_Paulo
DEFAULT_APPOINTMENT_DURATION_MINUTES=60

# Integração com o WhatsApp (via Baileys — conexão não-oficial, número dedicado).
# Deixe "false" pra rodar a API sem tentar conectar no WhatsApp (ex: testando o site).
WHATSAPP_ENABLED=false

# Tempo de espera antes de responder (em milissegundos), pra não parecer robô
# respondendo instantâneo. Reinicia a cada mensagem nova, até o teto abaixo.
WHATSAPP_MIN_DELAY_MS=120000
WHATSAPP_MAX_DELAY_MS=600000
WHATSAPP_MAX_TOTAL_WAIT_MS=900000

# MODO TESTE: se preenchido, o robô só responde esse número (só os dígitos
# importam, ex: 5511999998888) e ignora mensagens de qualquer outro número.
# Deixe em branco pra responder todo mundo (produção).
WHATSAPP_TEST_ONLY_NUMBER=
